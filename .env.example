# Passli Environment Configuration
# Copy this file to .env for local testing or add these variables into Railway's Variables tab.

# Django Security
SECRET_KEY=replace-with-a-secure-random-key-in-production
DEBUG=False

# Vault AES-256-GCM Master Encryption Key (32-byte hex string)
# Optional in development (derived automatically from SECRET_KEY via HKDF-SHA256 if unset)
# In production, generate with: python -c "import secrets; print(secrets.token_hex(32))"
VAULT_MASTER_KEY=

# Cryptographic Key Rotation (Optional)
# Set previous key to allow seamless decryption and re-encryption of legacy files
VAULT_MASTER_KEY_PREVIOUS=
VAULT_KEY_VERSION=1

# Reverse Proxy & IP Resolution
# Number of trusted upstream proxies (e.g. 1 on Railway / Render / Nginx)
TRUSTED_PROXY_COUNT=1

# Initial Superadmin Configuration (for ensure_superadmin command)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-admin-password

# Optional Secondary Superadmin Configuration (for co-author / co-maintainer)
DJANGO_SECONDARY_SUPERUSER_USERNAME=
DJANGO_SECONDARY_SUPERUSER_EMAIL=
DJANGO_SECONDARY_SUPERUSER_PASSWORD=

# Host & Origin Whitelisting (comma-separated, specify your actual domain)
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.up.railway.app
CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# Database (Optional - Railway PostgreSQL plugin injects this automatically)
# DATABASE_URL=postgresql://postgres:password@host:5432/railway

# Public Application URL (Points to your live Railway HTTPS domain)
# Required for generating correct, trusted password reset links and security alert links.
APP_URL=https://your-actual-railway-public-url

# ==============================================================================
# Transactional Email & SMTP Configuration
# ==============================================================================
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# For local offline testing, use console backend:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password (16 characters): https://myaccount.google.com/apppasswords
# 3. Enter the 16-character App Password (without spaces) in SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASS=replace-with-your-16-char-google-app-password
EMAIL_FROM=your-sender@gmail.com

