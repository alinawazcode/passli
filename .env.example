# Passli Environment Configuration
# Copy this file to .env for local testing or set these variables in your production environment.

# Django Security
SECRET_KEY=replace-with-a-secure-random-key-in-production
DEBUG=False

# Vault AES-256-GCM Master Encryption Key (32-byte hex string or base64)
# In development (DEBUG=True), derived automatically from SECRET_KEY if unset.
# In production (DEBUG=False), mandatory: generate with python -c "import secrets; print(secrets.token_hex(32))"
VAULT_MASTER_KEY=

# Cryptographic Key Rotation (Optional)
# Set previous key to allow seamless decryption and re-encryption of legacy files
VAULT_MASTER_KEY_PREVIOUS=
VAULT_KEY_VERSION=1

# Reverse Proxy & IP Resolution
# Number of trusted upstream proxies (e.g. 1 on PythonAnywhere / Nginx / Reverse Proxy)
TRUSTED_PROXY_COUNT=1

# Initial Superadmin Configuration (for ensure_superadmin command)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-admin-password

# Optional Secondary Superadmin Configuration (for co-author / co-maintainer)
DJANGO_SECONDARY_SUPERUSER_USERNAME=
DJANGO_SECONDARY_SUPERUSER_EMAIL=
DJANGO_SECONDARY_SUPERUSER_PASSWORD=

# Host & Origin Whitelisting (comma-separated, specify your actual domain)
ALLOWED_HOSTS=localhost,127.0.0.1,your-username.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://your-username.pythonanywhere.com

# Database (Optional - defaults to SQLite at db.sqlite3; supports external PostgreSQL via DATABASE_URL)
# DATABASE_PATH=/home/your-username/passli_data/db.sqlite3
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Public Application Base URL (e.g. https://<username>.pythonanywhere.com)
# Required in production for links in verification, password reset, and alert emails.
APP_URL=https://your-username.pythonanywhere.com

# ==============================================================================
# Transactional Email & SMTP Configuration
# ==============================================================================
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# If SMTP_USER or SMTP_PASS is omitted, Passli safely falls back to console backend.

# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password (16 characters): https://myaccount.google.com/apppasswords
# 3. Enter the 16-character App Password (without spaces) in SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASS=replace-with-your-16-char-google-app-password
EMAIL_FROM=your-sender@gmail.com


